generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(ADMIN)
  createdAt    DateTime      @default(now())
  posts        BlogPost[]
  activityLogs ActivityLog[]
}

model SiteSettings {
  id              String   @id @default("singleton")
  firmName        String
  tagline         String
  logoUrl         String?
  faviconUrl      String?
  phone           String?
  email           String?
  address         String?
  whatsapp        String?
  businessHours   String?
  copyrightText   String?
  googleMapsEmbed String?
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  socialLinks     Json?
  updatedAt       DateTime @updatedAt
}

enum NavLocation {
  HEADER
  HEADER_CTA
  FOOTER_QUICK_LINKS
  FOOTER_SERVICES
  FOOTER_LEGAL
}

model NavigationItem {
  id        String      @id @default(cuid())
  location  NavLocation
  label     String
  url       String
  sortOrder Int         @default(0)
  published Boolean     @default(true)
}

enum SectionType {
  HERO
  TRUST
  ABOUT
  SERVICES
  FEATURES
  PROCESS
  INDUSTRIES
  STATS
  TEAM
  LOGOS
  TESTIMONIALS
  BLOGS
  CTA
  CONTACT
  CUSTOM
}

model PageSection {
  id        String      @id @default(cuid())
  page      String      @default("home")
  type      SectionType
  title     String?
  subtitle  String?
  content   Json?
  media     Json?
  settings  Json?
  sortOrder Int         @default(0)
  isVisible Boolean     @default(true)
  updatedAt DateTime    @updatedAt

  @@unique([page, type])
}

model TrustStripItem {
  id        String  @id @default(cuid())
  label     String
  icon      String?
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model WhyChooseUsFeature {
  id          String  @id @default(cuid())
  title       String
  description String
  icon        String?
  sortOrder   Int     @default(0)
  published   Boolean @default(true)
}

model ProcessStep {
  id          String  @id @default(cuid())
  number      String
  title       String
  description String
  icon        String?
  sortOrder   Int     @default(0)
  published   Boolean @default(true)
}

model Statistic {
  id        String  @id @default(cuid())
  label     String
  value     String
  prefix    String?
  suffix    String?
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model ClientLogo {
  id        String  @id @default(cuid())
  name      String
  logoUrl   String
  website   String?
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model TeamMember {
  id            String  @id @default(cuid())
  name          String
  designation   String
  qualification String?
  biography     String?
  experience    String?
  photoUrl      String?
  linkedinUrl   String?
  email         String?
  sortOrder     Int     @default(0)
  published     Boolean @default(true)
}

model Testimonial {
  id          String  @id @default(cuid())
  clientName  String
  company     String?
  designation String?
  photoUrl    String?
  content     String
  rating      Int     @default(5)
  sortOrder   Int     @default(0)
  published   Boolean @default(true)
}

model Service {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  shortDescription String
  longDescription  String
  highlights       String[] @default([])
  icon             String?
  imageUrl         String?
  featured         Boolean  @default(false)
  sortOrder        Int      @default(0)
  published        Boolean  @default(false)
  seoTitle         String?
  seoDescription   String?
  faqs             Faq[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  published Boolean  @default(true)
}

model Industry {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String
  imageUrl    String?
  icon        String?
  sortOrder   Int     @default(0)
  published   Boolean @default(false)
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

model BlogCategory {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  sortOrder Int        @default(0)
  published Boolean    @default(true)
  posts     BlogPost[]
}

model BlogPost {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String
  content        String
  featuredImage  String?
  categoryId     String?
  category       BlogCategory? @relation(fields: [categoryId], references: [id])
  tags           String[]
  authorId       String?
  author         User?         @relation(fields: [authorId], references: [id])
  readingTime    Int?
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  canonicalUrl   String?
  status         PostStatus    @default(DRAFT)
  featured       Boolean       @default(false)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum EnquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CONVERTED
  CLOSED
}

model Enquiry {
  id            String        @id @default(cuid())
  name          String
  email         String
  phone         String?
  company       String?
  serviceNeeded String?
  message       String
  status        EnquiryStatus @default(NEW)
  internalNotes EnquiryNote[]
  createdAt     DateTime      @default(now())
}

model EnquiryNote {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  note      String
  createdAt DateTime @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
}

model MediaAsset {
  id         String    @id @default(cuid())
  fileName   String
  url        String
  type       MediaType
  fileSize   Int
  altText    String?
  uploadedAt DateTime  @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
}
